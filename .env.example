# ==============================================================================
# INDSAFE - Environment Variables Configuration
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# Copy this file to .env and fill in your environment specific credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Banco de Dados (Database - MySQL)
# ------------------------------------------------------------------------------
MYSQL_DATABASE=distrito_industrial_cba
MYSQL_USER=user_indsafe
MYSQL_PASSWORD=seu_password_aqui
MYSQL_ROOT_PASSWORD=seu_root_password_aqui

# Credenciais específicas para ambiente de produção (usado no docker-compose.yml)
MYSQL_DATABASE_PROD=distrito_industrial_cba
MYSQL_USER_PROD=user_indsafe
MYSQL_PASSWORD_PROD=seu_password_prod_aqui
MYSQL_ROOT_PASSWORD_PROD=seu_root_password_prod_aqui

# ------------------------------------------------------------------------------
# Serviço de E-mail (SMTP - PHPMailer)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@dominio.com
MAIL_PASSWORD=sua_senha_de_aplicativo_ou_token
MAIL_FROM_ADDRESS=seu_email@dominio.com
MAIL_FROM_NAME="INDSAFE - Suporte"
